<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>io.mitcon84.aicontextbuilder</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>AI Context Builder</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>mitcon84</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        AI Context Builder helps developers collect selected IDE context and turn it into a clean Markdown prompt for external AI coding agents.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>


    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="AI Context"
                anchor="right"
                factoryClass="io.mitcon84.aicontext.ui.AiContextToolWindowFactory"/>
        <applicationConfigurable
                parentId="tools"
                instance="io.mitcon84.aicontext.settings.AiSettingsConfigurable"/>
    </extensions>

    <actions>
        <action
                id="io.mitcon84.aicontext.addSelectionToContext"
                class="io.mitcon84.aicontext.actions.AddSelectionToContextAction"
                text="Add Selection to AI Context"
                description="Add selected code to AI coding agent context">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="io.mitcon84.aicontext.addCurrentFileToContext"
                class="io.mitcon84.aicontext.actions.AddCurrentFileToContextAction"
                text="Add Current File to AI Context"
                description="Add the current file to AI coding agent context">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
